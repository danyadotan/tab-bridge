{
  "manifest_version": 3,
  "name": "TAB Overlay",
  "version": "0.2.0",
  "description": "Save your next step on a page and see it when you return.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
